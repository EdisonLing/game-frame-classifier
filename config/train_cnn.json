{
  "schema": "gfc.train_cnn/1",
  "label_set": "seven",
  "seed": 360,
  "model": {
    "channels": [32, 64, 128, 256],
    "fc_dim": 256,
    "dropout": 0.5,
    "head": "flatten"
  },
  "optim": {
    "name": "adam",
    "lr": 0.001,
    "weight_decay": 0.0001
  },
  "batch_size": 64,
  "epochs": 30,
  "early_stop_patience": 6,
  "class_weights": "balanced",
  "device": "auto",
  "cache": "ram",
  "num_workers": 0,
  "augment": {
    "affine_p": 0.5,
    "scale": [0.85, 1.15],
    "translate": [0.02, 0.02],
    "jitter_p": 0.8,
    "brightness": 0.2,
    "contrast": 0.2,
    "saturation": 0.2,
    "hue": 0.02
  }
}
